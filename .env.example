FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

GEMINI_API_KEY=
# SPECIFICATION.md specifies gemini-2.5-flash, but the API no longer serves that model
# to new keys ("no longer available to new users"). Verified working:
# gemini-3.6-flash, gemini-3.7-flash. Read from the environment, never in code.
GEMINI_MODEL=gemini-3.6-flash

# Model routing (LiteLLM). Comma-separated, tried in order; a 429 or 503 falls
# through to the next model. Gemini meters free quota PER MODEL, so a chain
# multiplies the requests available during a workshop.
# Append a local model for unlimited offline runs: ,ollama/llama3.1
# Leave blank to use GEMINI_MODEL alone.
LLM_MODELS=gemini/gemini-3.1-flash-lite,gemini/gemini-3.5-flash,gemini/gemini-3.6-flash

# live | cached | auto. The spec ships "live"; "auto" is safer for a live demo
# because it falls back to clearly labelled cached results instead of failing.
DEMO_MODE=auto

DEFAULT_SOURCE_CATEGORY=company_careers
DEFAULT_FRESHNESS_WINDOW=last_24_hours

# Seniority the search starts on: internship | entry | mid | senior |
# staff_principal | manager | unknown. "unknown" means no level filtering at
# all. The workshop default is internship because the fictional resume is a
# student's. A posting that never states a level always stays "unknown" on
# screen; this setting only shapes the search.
DEFAULT_EXPERIENCE_LEVEL=internship

MAX_JOB_RESULTS=8
MAX_JOB_DESCRIPTION_CHARS=20000
ATS_RECOMMENDATION_THRESHOLD=80

# Per-Firecrawl-request timeout. The spec's 10s is too short: search+scrape of
# 8 public job pages was measured at 3-48s against the live API.
SEARCH_TIMEOUT_SECONDS=25

# Which resume to score against. The default is the fictional workshop
# profile. To use your own: copy data/my_resume.template.json to
# data/my_resume.json, fill it in, and point this at it. Personal
# resumes are git-ignored. See docs/USE_YOUR_OWN_RESUME.md.
RESUME_FILE=data/sample_resume.json

CACHE_FILE=data/cached_jobs.json
OUTPUT_DIR=output
